PORT=8080
DATABASE_URL=./data/agape.db
CORS_ORIGINS=http://localhost:5173
ENV=development

# Уведомления о новых заявках в Telegram (опционально; без токена и chat_id — не отправляются)
# Пошаговая настройка: docs/TELEGRAM-BOT-SETUP.md
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Токен для GET/PATCH /api/leads (Authorization: Bearer …). Пусто — админ-роуты отвечают 503
LEADS_ADMIN_TOKEN=
