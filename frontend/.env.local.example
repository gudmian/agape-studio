# Локальная связка: Vite проксирует /cms-directus → http://127.0.0.1:8055 (см. vite.config.ts).
# Прокси подставляет Bearer для /assets — иначе картинки из CMS дают 403 (у <img> нет Authorization).
VITE_CMS_URL=/cms-directus

# Создайте в Directus: Settings → Access Tokens (read: projects, project_gallery, services, process_steps, site_content, directus_files).
# Если VITE_CMS_URL указывает прямо на http://127.0.0.1:8055, к URL ассетов добавится ?access_token=… (см. src/api/cms.ts).
VITE_CMS_TOKEN=замените_на_ваш_статический_токен
