# Сборка продакшена: скопируйте в .env.production или задайте в CI.
# Vite вшивает эти значения на этапе npm run build.

# Публичный URL Directus (тот же origin, что открыт в браузере, с https).
VITE_CMS_URL=https://cms.example.com

# Статический токен только read: projects, project_gallery, services, process_steps, site_content, directus_files.
VITE_CMS_TOKEN=замените_на_токен
